---
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const nav = [
  { href: "/#how", label: "工作原理" },
  { href: "/#targets", label: "分析目标" },
  { href: "/cases", label: "案例" },
  { href: "/guides", label: "指南" },
  { href: "/#rl", label: "RL 环境" },
];

const isCurrent = (href: string) => {
  if (href === "/guides") return currentPath === "/guides" || currentPath.startsWith("/guides/");
  return currentPath === href;
};
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-line bg-paper/95 backdrop-blur-xl supports-[backdrop-filter]:bg-paper/92"
>
  <div class="shell flex h-[68px] items-center justify-between gap-6">
    <a href="/" class="group flex shrink-0 items-center gap-2.5">
      <span
        class="flex h-8 w-8 items-center justify-center bg-ink font-mono text-[13px] font-bold text-paper transition-colors duration-300 group-hover:bg-rust"
        aria-hidden="true">R</span
      >
      <span class="flex items-baseline gap-2">
        <span class="font-mono text-[15px] font-bold tracking-[0.16em] text-ink">REA</span>
        <span class="hidden text-[13px] text-muted sm:inline">逆向一切</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="主要">
      {
        nav.map((item) => {
          const active = isCurrent(item.href);
          return (
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class={`link-underline py-1 text-[13.5px] ${
                active ? "font-medium text-ink" : "text-ink-2 hover:text-ink"
              }`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex shrink-0 items-center gap-3">
      <a
        href="https://github.com/morluto/rea"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden py-2 font-mono text-[12px] tracking-[0.1em] text-muted transition-colors duration-300 hover:text-ink lg:inline"
        >GITHUB</a
      >
      <a href="/#start" class="btn btn-solid hidden px-4 py-2.5 sm:inline-flex">开始安装</a>

      <button
        type="button"
        popovertarget="mobile-nav-popover"
        class="flex min-h-9 min-w-9 cursor-pointer items-center justify-center border border-line-2 md:hidden"
        aria-label="打开菜单"
      >
        <span class="flex flex-col gap-[5px]" aria-hidden="true">
          <span class="block h-px w-4 bg-ink"></span>
          <span class="block h-px w-4 bg-ink"></span>
          <span class="block h-px w-4 bg-ink"></span>
        </span>
      </button>

      <nav
        id="mobile-nav-popover"
        popover="auto"
        class="mobile-nav-popover md:hidden"
        aria-label="移动端"
      >
        {
          nav.map((item) => {
            const active = isCurrent(item.href);
            return (
              <a
                href={item.href}
                aria-current={active ? "page" : undefined}
                class={`block px-3 py-2.5 text-sm transition-colors hover:bg-paper-2 hover:text-ink ${
                  active ? "font-medium text-ink" : "text-ink-2"
                }`}
              >
                {item.label}
              </a>
            );
          })
        }
        <a
          href="/#start"
          class="mt-1 block bg-ink px-3 py-2.5 text-center font-mono text-[12px] tracking-wider text-paper"
          >开始安装</a
        >
      </nav>
    </div>
  </div>
</header>

<script>
  const mobileNav = document.getElementById("mobile-nav-popover");
  if (mobileNav) {
    mobileNav.addEventListener("click", (event) => {
      if ((event.target as Element | null)?.closest("a") && typeof mobileNav.hidePopover === "function") {
        mobileNav.hidePopover();
      }
    });
  }
</script>
