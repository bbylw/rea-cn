---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import CtaPanel from "../components/CtaPanel.astro";

interface GuideEntry {
  eyebrow: string;
  title: string;
  body: string;
  route?: string[];
  linkLabel: string;
  href: string;
  external?: boolean;
  footnote?: {
    prefix: string;
    label: string;
    href: string;
    suffix: string;
  };
}

const guides: GuideEntry[] = [
  {
    eyebrow: "第一次调查",
    title: "设置 REA",
    body: "连接你的编程助手，或在终端中使用 REA。完成 MCP 服务注册与工作流指引安装后，即可开始第一次分析。",
    linkLabel: "开始使用 REA",
    href: "/guides/get-started",
  },
  {
    eyebrow: "原生二进制",
    title: "还原声像定位的计算",
    body: "从 Windows 游戏可执行文件开始。检查指令，跟随调用者，读取数字常量并检查恢复的 C。",
    route: ["指令", "调用方", "常量", "C 函数"],
    linkLabel: "原生分析指南",
    href: "/guides/native",
  },
  {
    eyebrow: "JavaScript & Electron",
    title: "追踪 CSV 导出",
    body: "一个小 Notes 应用把同一个功能分散在渲染进程、预加载脚本和主进程三处。用 REA 把 API、IPC 通道和写文件的代码关联起来。",
    route: ["按钮", "预加载 API", "IPC", "CSV 文件"],
    linkLabel: "JavaScript & Electron 指南",
    href: "/guides/javascript",
    footnote: {
      prefix: "对于更大的打包应用，请看",
      label: "Notion 的剪贴板衔接逻辑",
      href: "/cases",
      suffix: "。",
    },
  },
  {
    eyebrow: "浏览器行为",
    title: "观察点击",
    body: "打开一个可以正常运行的 Notes 示例，捕获导出请求，并找到把响应转为下载文件的代码。",
    route: ["你的点击", "捕获的请求", "导出脚本"],
    linkLabel: "浏览器观察指南",
    href: "/guides/browser",
  },
  {
    eyebrow: "RL 环境",
    title: "为智能体构建环境",
    body: "录制 Web 应用会话，将其转为工具和本地数据，再添加任务和奖励检查。",
    route: ["录制", "构建", "运行", "评测"],
    linkLabel: "构建环境指南",
    href: "/guides/rl-environments",
  },
];

const docs = [
  { label: "安装与设置", note: "智能体注册、提供方配置、更新和卸载", href: "https://github.com/morluto/rea/blob/main/docs/getting-started/installation.md" },
  { label: "就绪检查与故障排查", note: "诊断特定智能体或分析引擎", href: "https://github.com/morluto/rea/blob/main/docs/getting-started/installation.md#check-readiness-for-your-task" },
  { label: "CLI 与 Evidence", note: "命令、提供方选择、快照、导入导出和退出状态", href: "https://github.com/morluto/rea/blob/main/docs/getting-started/cli.md" },
  { label: "MCP 契约", note: "工具结果、会话和引导式调查", href: "https://github.com/morluto/rea/blob/main/docs/reference/mcp-contracts.md" },
  { label: "智能体提示词", note: "引导式调查的提示词设计", href: "https://github.com/morluto/rea/blob/main/docs/getting-started/mcp-prompts.md" },
  { label: "工具目录", note: "构建时生成的工具、提供方与 CLI 命令清单", href: "https://github.com/morluto/rea/blob/main/docs/reference/mcp-contracts.md#generated-catalog" },
  { label: "支持的格式与运行要求", note: "44 类分析目标的返回内容与环境要求", href: "https://github.com/morluto/rea/blob/main/docs/reference/supported-targets.md" },
  { label: "测试指南", note: "贡献代码时的验证流程", href: "https://github.com/morluto/rea/blob/main/docs/development/testing.md" },
];
---

<Layout
  title="逆向工程指南 · REA"
  description="通过简短示例学习 REA：设置 REA、还原原生计算、追踪 Electron CSV 导出、观察浏览器请求与构建 RL 环境。"
>
  <PageHeader
    eyebrow="使用指南"
    title="REA 分析指南"
    lead="分析原生函数、Electron 导出流程、浏览器请求，或为智能体构建 RL 环境。每个指南都包含提示词、代码和结果。"
    meta={["指南数量|5 篇", "包含内容|提示词 · 代码 · 结果", "更新方式|rea update"]}
  />

  <section class="border-b border-line bg-paper">
    <div class="shell py-16 sm:py-20">
      <ul class="border-t border-line">
        {
          guides.map((g, i) => (
            <li
              data-reveal
              style={`--reveal-delay:${i * 80}ms`}
              class="row-lift border-b border-line py-9 sm:py-11"
            >
              <div class="grid gap-6 lg:grid-cols-[minmax(0,0.42fr)_minmax(0,1fr)] lg:gap-12">
                <div>
                  <p class="label text-rust-2">{g.eyebrow}</p>
                </div>

                <div>
                  <h2 class="text-[24px] leading-snug text-ink sm:text-[28px]">{g.title}</h2>
                  <p class="mt-3.5 max-w-[58ch] text-[15.5px] leading-[1.85] text-ink-2">
                    {g.body}
                  </p>

                  {g.route && (
                    <div
                      class="mt-5 flex flex-wrap items-center gap-y-2 font-mono text-[12px] tracking-[0.06em] text-ink"
                      aria-label="分析路径"
                    >
                      {g.route.map((step, idx) => (
                        <>
                          <span class="border border-line-2 bg-paper-2 px-2.5 py-1">{step}</span>
                          {idx < g.route!.length - 1 && (
                            <span class="px-2 text-rust" aria-hidden="true">→</span>
                          )}
                        </>
                      ))}
                    </div>
                  )}

                  <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2">
                    <a
                      href={g.href}
                      target={g.external ? "_blank" : undefined}
                      rel={g.external ? "noopener noreferrer" : undefined}
                      class="link-underline -mx-2 inline-block px-2 py-1.5 font-mono text-[12.5px] tracking-[0.08em] text-ink"
                    >
                      {g.linkLabel}
                    </a>
                  </div>

                  {g.footnote && (
                    <p class="mt-3 text-[13.5px] leading-[1.7] text-muted">
                      {g.footnote.prefix}
                      <a
                        href={g.footnote.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="underline decoration-line-2 underline-offset-4 transition-colors hover:text-ink hover:decoration-ink"
                      >
                        {g.footnote.label}
                      </a>
                      {g.footnote.suffix}
                    </p>
                  )}
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-b border-line bg-paper-2">
    <div class="shell py-16 sm:py-20">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.6fr)] lg:gap-20">
        <div>
          <h2 data-reveal class="display text-[clamp(1.8rem,3.2vw,2.5rem)] text-ink">
            具体选项与结果契约
          </h2>
          <p data-reveal style="--reveal-delay:70ms" class="mt-6 max-w-[34ch] text-[15px] leading-[1.8] text-ink-2">
            前提条件、参数、退出状态与证据结构都在这里定义。
          </p>
        </div>

        <ul data-reveal style="--reveal-delay:100ms" class="grid border-t border-line sm:grid-cols-2 sm:border-l">
          {
            docs.map((d) => (
              <li class="border-b border-line sm:border-r">
                <a
                  href={d.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group block h-full px-5 py-5 transition-colors duration-300 hover:bg-paper"
                >
                  <span class="flex items-baseline justify-between gap-3">
                    <span class="inline-block text-[15.5px] text-ink transition-colors duration-300 group-hover:text-rust-2">
                      {d.label}
                    </span>
                  </span>
                  <span class="mt-2 block text-[13px] leading-relaxed text-muted">{d.note}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <CtaPanel />
</Layout>
